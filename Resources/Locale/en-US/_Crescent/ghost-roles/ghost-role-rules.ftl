# Generic ghost role rule texts referenced by upstream ghost roles (ERT, nuclear operatives, ninja...) that this
# locale set never defined, so the ghost role window showed the raw message id instead of any rules.
ghost-role-information-nonantagonist-rules = You are [color=green][bold]not an antagonist[/bold][/color]. Normal crew rules apply: do not harm other players without a roleplay reason.
ghost-role-information-antagonist-rules = You are an [color=red][bold]antagonist[/bold][/color]. You are free to act against others to achieve your goals.
ghost-role-information-rules-default-team-antagonist = You are a [color=red][bold]Team Antagonist[/bold][/color]. Work together with your team to achieve your goals.
