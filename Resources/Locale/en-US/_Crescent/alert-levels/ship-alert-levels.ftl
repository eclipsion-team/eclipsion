# Ship alert levels (combatShipAlerts). The alert level system, communications console and PDA look these up by
# the level id; without them the raw message ids were shown in announcements.

alert-level-cruise = Cruise
alert-level-cruise-announcement = The vessel is under way with no known threats. Crew may return to their regular duties.
alert-level-cruise-instructions = Carry on with your regular duties.

alert-level-combat = Combat
alert-level-combat-announcement = The vessel is engaging or preparing to engage hostile forces. All crew to combat stations.
alert-level-combat-instructions = Report to your combat station and follow the orders of the bridge.

alert-level-boarders = Boarders
alert-level-boarders-announcement = Hostile boarders are aboard the vessel. Armed crew are to repel them; everyone else is to shelter in place.
alert-level-boarders-instructions = Armed crew repel the boarders. Everyone else shelters in place and keeps doors shut.

alert-level-damage = Damage
alert-level-damage-announcement = The vessel has sustained significant damage. Engineering and damage control teams are to respond immediately.
alert-level-damage-instructions = Damage control teams respond to breaches. Everyone else stays clear of damaged sections.

alert-level-scuttle = Scuttle
alert-level-scuttle-announcement = The vessel is being scuttled. All crew are to abandon ship immediately.
alert-level-scuttle-instructions = Abandon ship. Make for the nearest escape craft or friendly vessel.
