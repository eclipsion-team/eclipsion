<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:repair="clr-namespace:Content.Client._Crescent.RepairStation"
                      Title="{Loc 'ship-repair-station-title'}"
                      MinSize="520 600"
                      SetSize="560 680">
    <BoxContainer Orientation="Vertical" Margin="10 6 10 10">

        <!-- Masthead. What the slip is doing, in two words, before any of the figures. -->
        <BoxContainer Orientation="Horizontal" Margin="2 0 2 6">
            <Label Text="{Loc 'ship-repair-station-masthead'}" StyleClasses="ConsoleHeading"
                   VerticalAlignment="Center"/>
            <Control HorizontalExpand="True"/>
            <Label Name="SlipStateLabel" StyleClasses="ConsoleText" VerticalAlignment="Center"/>
        </BoxContainer>

        <!-- Vessel in the clamps -->
        <PanelContainer Margin="0 0 0 6">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
            </PanelContainer.PanelOverride>

            <BoxContainer Orientation="Horizontal" Margin="8 6" SeparationOverride="8">
                <Label Text="{Loc 'ship-repair-station-ship'}" StyleClasses="ConsoleSubHeading"
                       VerticalAlignment="Center"/>
                <OptionButton Name="ShipOption" HorizontalExpand="True"/>
                <Button Name="SnapshotButton" Text="{Loc 'ship-repair-station-snapshot'}" Visible="False"/>
            </BoxContainer>
        </PanelContainer>

        <!-- Status strip. Its accent edge is recoloured per status, so the box is built in code. -->
        <PanelContainer Name="StatusPanel" Margin="0 0 0 6">
            <Label Name="StatusLabel" StyleClasses="ConsoleText" Margin="10 6"/>
        </PanelContainer>

        <!-- Said out loud rather than left to be read off a survey full of zeroes. -->
        <PanelContainer Name="BlueprintPanel" Margin="0 0 0 6" Visible="False">
            <RichTextLabel Name="BlueprintLabel" Margin="10 6" HorizontalExpand="True"/>
        </PanelContainer>

        <!-- Survey -->
        <PanelContainer Name="SurveyPanel" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
            </PanelContainer.PanelOverride>

            <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="3" VerticalExpand="True">
                <Label Text="{Loc 'ship-repair-station-section-structure'}" StyleClasses="ConsoleSubHeading"/>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 2 0 4"/>

                <repair:RepairSurveyRow Name="TilesRow" Title="{Loc 'ship-repair-station-hull-breaches'}"/>
                <repair:RepairSurveyRow Name="StrippedRow" Title="{Loc 'ship-repair-station-stripped-tiles'}"/>
                <repair:RepairSurveyRow Name="PartsRow" Title="{Loc 'ship-repair-station-missing-parts'}"/>
                <repair:RepairSurveyRow Name="DamagedRow" Title="{Loc 'ship-repair-station-damaged-parts'}"/>

                <Label Text="{Loc 'ship-repair-station-section-finish'}" StyleClasses="ConsoleSubHeading"
                       Margin="0 8 0 0"/>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 2 0 4"/>

                <repair:RepairSurveyRow Name="DecalsRow" Title="{Loc 'ship-repair-station-decals'}"/>
                <repair:RepairSurveyRow Name="CleaningRow" Title="{Loc 'ship-repair-station-cleaning'}"/>

                <Label Text="{Loc 'ship-repair-station-section-stores'}" StyleClasses="ConsoleSubHeading"
                       Margin="0 8 0 0"/>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 2 0 4"/>

                <repair:RepairSurveyRow Name="RestockRow" Title="{Loc 'ship-repair-station-restock'}"/>

                <Control VerticalExpand="True" MinHeight="8"/>

                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 0 0 4"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'ship-repair-station-work-items'}" StyleClasses="ConsoleText"/>
                    <Control HorizontalExpand="True"/>
                    <Label Name="WorkItemsLabel" StyleClasses="ConsoleText"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Work under way. Takes the survey's place rather than sitting under it. -->
        <PanelContainer Name="ProgressPanel" VerticalExpand="True" Visible="False">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
            </PanelContainer.PanelOverride>

            <BoxContainer Orientation="Vertical" Margin="10 8">
                <Label Name="ProgressTitleLabel" StyleClasses="ConsoleSubHeading"/>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 2 0 8"/>

                <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                    <Label Name="PercentLabel" StyleClasses="ConsoleHeading"/>
                    <Control HorizontalExpand="True"/>
                    <Label Name="EtaLabel" StyleClasses="ConsoleText" VerticalAlignment="Center"/>
                </BoxContainer>

                <ProgressBar Name="WorkBar" HorizontalExpand="True" SetHeight="10"
                             MinValue="0" MaxValue="1" Value="0"/>

                <Label Name="PartsProgressLabel" StyleClasses="LabelSecondaryColor" Margin="0 8 0 0"/>

                <Control VerticalExpand="True"/>
            </BoxContainer>
        </PanelContainer>

        <!-- Bill. Hidden while the slip works, since the quote it was authorised on is spent. -->
        <PanelContainer Name="BillPanel" Margin="0 6 0 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
            </PanelContainer.PanelOverride>

            <BoxContainer Orientation="Vertical" Margin="10 6">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'ship-repair-station-quote'}" StyleClasses="ConsoleSubHeading"
                           VerticalAlignment="Center"/>
                    <Control HorizontalExpand="True"/>
                    <Label Name="QuoteLabel" StyleClasses="ConsoleHeading"/>
                </BoxContainer>

                <BoxContainer Name="BalanceRow" Orientation="Horizontal" Margin="0 2 0 0">
                    <Label Text="{Loc 'ship-repair-station-balance'}" StyleClasses="ConsoleText"
                           VerticalAlignment="Center"/>
                    <Control HorizontalExpand="True"/>
                    <Label Name="BalanceLabel" StyleClasses="ConsoleText" VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0" SeparationOverride="6">
            <Button Name="CancelButton"
                    Text="{Loc 'ship-repair-station-cancel'}"
                    StyleClasses="ButtonCaution"
                    HorizontalExpand="True"/>
            <Button Name="StartButton"
                    Text="{Loc 'ship-repair-station-start'}"
                    HorizontalExpand="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
