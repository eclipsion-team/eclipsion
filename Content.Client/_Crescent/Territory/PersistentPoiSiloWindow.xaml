<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'persistent-poi-silo-ui-title'}"
                      MinSize="420 320"
                      SetSize="460 460">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <RichTextLabel Name="HintLabel" HorizontalExpand="True"/>
        <PanelContainer StyleClasses="LowDivider"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="MaterialList" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
        </ScrollContainer>
        <Label Name="EmptyLabel" Text="{Loc 'persistent-poi-silo-examine-empty'}" StyleClasses="LabelSecondaryColor"/>
    </BoxContainer>
</controls:FancyWindow>
