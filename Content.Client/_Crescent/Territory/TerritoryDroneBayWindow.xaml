<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'territory-drone-bay-ui-title'}"
                      MinSize="660 620"
                      SetSize="720 760">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6"
                  VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="HolderLabel" StyleClasses="LabelHeading" HorizontalExpand="True"/>
            <Label Name="LevelLabel" StyleClasses="LabelSecondaryColor" VerticalAlignment="Center"/>
        </BoxContainer>
        <RichTextLabel Name="StatusLabel" HorizontalExpand="True" Visible="False"/>

        <TabContainer Name="Tabs" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="SquadronTab" Orientation="Vertical" Margin="6" SeparationOverride="8"
                          VerticalExpand="True" HorizontalExpand="True">
                <Label Name="SquadronSummary"/>

                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a44" BorderThickness="1"
                                          ContentMarginLeftOverride="8" ContentMarginRightOverride="8"
                                          ContentMarginTopOverride="6" ContentMarginBottomOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" SeparationOverride="4">
                        <Label Text="{Loc 'territory-drone-bay-ui-all'}" StyleClasses="LabelSecondaryColor"/>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                            <Button Name="AllDefendButton" StyleClasses="OpenRight" HorizontalExpand="True"
                                    MinHeight="30" Text="{Loc 'territory-drone-bay-ui-defend'}"/>
                            <Button Name="AllAttackButton" StyleClasses="OpenBoth" HorizontalExpand="True"
                                    MinHeight="30" Text="{Loc 'territory-drone-bay-ui-attack'}"/>
                            <Button Name="AllHoldButton" StyleClasses="OpenLeft" HorizontalExpand="True"
                                    MinHeight="30" Text="{Loc 'territory-drone-bay-ui-hold'}"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                            <Button Name="AllPowerDownButton" StyleClasses="OpenRight" HorizontalExpand="True"
                                    MinHeight="30" Text="{Loc 'territory-drone-bay-ui-power-down'}"/>
                            <Button Name="AllPowerUpButton" StyleClasses="OpenLeft" HorizontalExpand="True"
                                    MinHeight="30" Text="{Loc 'territory-drone-bay-ui-power-up'}"/>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                    <Label Name="TargetsHeading" StyleClasses="LabelSecondaryColor"/>
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#141417" BorderColor="#3a3a44" BorderThickness="1"
                                              ContentMarginLeftOverride="4" ContentMarginRightOverride="4"
                                              ContentMarginTopOverride="4" ContentMarginBottomOverride="4"/>
                        </PanelContainer.PanelOverride>
                        <ScrollContainer HScrollEnabled="False" SetHeight="132">
                            <BoxContainer Name="TargetList" Orientation="Vertical" SeparationOverride="2"
                                          HorizontalExpand="True"/>
                        </ScrollContainer>
                    </PanelContainer>
                    <RichTextLabel Name="TargetNote" HorizontalExpand="True"/>
                </BoxContainer>

                <Label Name="DronesHeading" StyleClasses="LabelSecondaryColor"/>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="DroneList" Orientation="Vertical" SeparationOverride="6"
                                  HorizontalExpand="True"/>
                </ScrollContainer>
            </BoxContainer>

            <ScrollContainer Name="HangarTab" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="8" HorizontalExpand="True">
                    <RichTextLabel Name="HintLabel" HorizontalExpand="True"/>

                    <PanelContainer Name="PaymentPanel" Visible="False">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#5a4a2a" BorderThickness="1"
                                              ContentMarginLeftOverride="8" ContentMarginRightOverride="8"
                                              ContentMarginTopOverride="6" ContentMarginBottomOverride="6"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4">
                            <Label Text="{Loc 'territory-payment-pay-from'}"/>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                                <Button Name="PersonalButton" ToggleMode="True" StyleClasses="OpenRight"
                                        HorizontalExpand="True" MinHeight="30"/>
                                <Button Name="FactionButton" ToggleMode="True" StyleClasses="OpenLeft"
                                        HorizontalExpand="True" MinHeight="30"/>
                            </BoxContainer>
                            <RichTextLabel Name="PaymentNote" HorizontalExpand="True"/>
                        </BoxContainer>
                    </PanelContainer>

                    <Label Name="BoughtLabel"/>
                    <BoxContainer Name="HullList" Orientation="Vertical" SeparationOverride="4"
                                  HorizontalExpand="True"/>
                    <RichTextLabel Name="HangarStatus" HorizontalExpand="True"/>
                </BoxContainer>
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
