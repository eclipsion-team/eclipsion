<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'territory-recruit-ui-title'}"
                      MinSize="560 480"
                      SetSize="620 600">
    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Label Name="HolderLabel" StyleClasses="LabelHeading" HorizontalExpand="True"/>
                <Label Name="LevelLabel" StyleClasses="LabelSecondaryColor" VerticalAlignment="Center"/>
            </BoxContainer>
            <RichTextLabel Name="HintLabel" HorizontalExpand="True"/>

            <PanelContainer Name="PaymentPanel" Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#5a4a2a" BorderThickness="1"
                                      ContentMarginLeftOverride="6" ContentMarginRightOverride="6"
                                      ContentMarginTopOverride="4" ContentMarginBottomOverride="4"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                    <Label Text="{Loc 'territory-payment-pay-from'}"/>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                        <Button Name="PersonalButton" ToggleMode="True" StyleClasses="OpenRight" HorizontalExpand="True"/>
                        <Button Name="FactionButton" ToggleMode="True" StyleClasses="OpenLeft" HorizontalExpand="True"/>
                    </BoxContainer>
                    <RichTextLabel Name="PaymentNote" HorizontalExpand="True"/>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'territory-recruit-ui-role'}" VerticalAlignment="Center"/>
                <OptionButton Name="RoleSelector" HorizontalExpand="True"/>
            </BoxContainer>
            <RichTextLabel Name="RoleDescription" HorizontalExpand="True"/>

            <BoxContainer Name="GarrisonSection" Orientation="Vertical" SeparationOverride="4">
                <Label Text="{Loc 'territory-recruit-ui-garrison'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="GarrisonLabel"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                    <Button Name="GarrisonOneButton" StyleClasses="OpenRight" HorizontalExpand="True" MinHeight="30"/>
                    <Button Name="GarrisonFillButton" StyleClasses="OpenLeft" HorizontalExpand="True" MinHeight="30"/>
                </BoxContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <Label Name="EscortHeading" StyleClasses="LabelSecondaryColor"/>
                <RichTextLabel Name="MercenaryNote" HorizontalExpand="True" Visible="False"/>
                <Label Name="EscortLabel"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                    <Button Name="EscortOneButton" StyleClasses="OpenRight" HorizontalExpand="True" MinHeight="30"/>
                    <Button Name="EscortFillButton" StyleClasses="OpenLeft" HorizontalExpand="True" MinHeight="30"/>
                </BoxContainer>
            </BoxContainer>
            <RichTextLabel Name="StatusLabel" HorizontalExpand="True"/>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
