<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'persistent-poi-mapping-ui-title'}"
                      MinSize="340 480"
                      SetSize="380 560">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="TerritoryLabel" StyleClasses="LabelHeading" ClipText="True"/>
        <RichTextLabel Name="SiloLabel" HorizontalExpand="True"/>
        <PanelContainer StyleClasses="LowDivider"/>
        <Button Name="MenuButton" Text="{Loc 'persistent-poi-mapping-ui-menu'}" StyleClasses="OpenBoth" MinHeight="30"/>
        <Button Name="DismantleButton" Text="{Loc 'persistent-poi-mapping-ui-dismantle'}" StyleClasses="OpenBoth" MinHeight="30" ToggleMode="True"/>
        <Button Name="PaintButton" Text="{Loc 'persistent-poi-mapping-ui-paint'}" StyleClasses="OpenBoth" MinHeight="30"/>
        <Button Name="RecenterButton" Text="{Loc 'persistent-poi-mapping-ui-recenter'}" StyleClasses="OpenBoth" MinHeight="30"/>
        <Button Name="LightsButton" Text="{Loc 'persistent-poi-mapping-ui-lights'}" ToolTip="{Loc 'persistent-poi-mapping-ui-lights-tooltip'}"
                StyleClasses="OpenBoth" MinHeight="30" ToggleMode="True"/>
        <Button Name="SubfloorButton" Text="{Loc 'persistent-poi-mapping-ui-subfloor'}" ToolTip="{Loc 'persistent-poi-mapping-ui-subfloor-tooltip'}"
                StyleClasses="OpenBoth" MinHeight="30" ToggleMode="True"/>
        <PanelContainer StyleClasses="LowDivider"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <RichTextLabel Name="HintLabel" HorizontalExpand="True"/>
        </ScrollContainer>
        <Button Name="LeaveButton" Text="{Loc 'persistent-poi-mapping-ui-leave'}" StyleClasses="Caution" MinHeight="30"/>
    </BoxContainer>
</controls:FancyWindow>
