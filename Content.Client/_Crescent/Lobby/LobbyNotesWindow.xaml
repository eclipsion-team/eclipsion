<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'lobby-notes-window-title'}"
                      MinSize="360 240"
                      SetSize="480 400">
    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
        <TextEdit Name="NotesEdit" HorizontalExpand="True" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="StatusLabel" HorizontalExpand="True" StyleClasses="LabelSubText" />
            <Button Name="ClearButton" Text="{Loc 'lobby-notes-clear-button'}" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
