<!-- Ratgore Start -->
<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:cui="clr-namespace:Content.Client._Crescent.UI"
                    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                    Title="{Loc hardliner-fire-control-window-title}"
                    SetSize="560 480"
                    MinSize="480 360">
    <BoxContainer Orientation="Vertical"
                  Margin="10"
                  VerticalExpand="True"
                  HorizontalExpand="True">
        <controls:StripeBack>
            <Label Text="{Loc hardliner-fire-control-window-heading}"
                   FontColorOverride="#7fe8ff"
                   Align="Center"/>
        </controls:StripeBack>
        <cui:HintLabel Name="HintLabel"
               Hint="{Loc hardliner-fire-control-window-hint}"
               HintColor="#9aa7b5"
               Margin="0,6,0,8"/>
        <!-- Eclipsion - permanent empty-state label, so the panel list itself is only ever reused. -->
        <Label Name="NoWeaponsLabel"
               Text="{Loc hardliner-fire-control-no-weapons}"
               FontColorOverride="#c4ccd6"
               Margin="4,12,4,4"
               Visible="False"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="WeaponsColumn"
                          Orientation="Vertical"
                          VerticalExpand="True"/>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
<!-- Ratgore End -->
