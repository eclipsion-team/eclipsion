<BoxContainer xmlns="https://spacestation14.io"
               xmlns:cui="clr-namespace:Content.Client._Crescent.UI"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical" Margin="6" VerticalExpand="True" HorizontalExpand="True">

    <!-- Treasury readout -->
    <PanelContainer Margin="0 0 0 6">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Horizontal" Margin="8 6">
            <Label Text="{Loc 'payment-console-treasury-label'}" StyleClasses="ConsoleSubHeading"/>
            <Label Name="TreasuryLabel" StyleClasses="ConsoleHeading" Margin="8 0 0 0"/>
            <Control HorizontalExpand="True"/>
            <Label Name="PayrollLabel" StyleClasses="ConsoleText"/>
        </BoxContainer>
    </PanelContainer>

    <cui:HintLabel Hint="{Loc 'payment-console-hint'}" Margin="2 0 0 6"/>

    <!-- Roster -->
    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderColor="#4d4d55" BorderThickness="2"/>
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Vertical" Margin="6" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'payment-console-roster-title'}" StyleClasses="ConsoleSubHeading"
                       VerticalAlignment="Center"/>
                <Control HorizontalExpand="True"/>
                <LineEdit Name="FilterEdit" MinWidth="180"
                          PlaceHolder="{Loc 'payment-console-filter-placeholder'}"/>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" SetHeight="2" Margin="0 4"/>

            <!-- Column headers, kept in step with the row layout in PaymentPanel.BuildRow. -->
            <BoxContainer Orientation="Horizontal" Margin="6 0 6 4" SeparationOverride="4">
                <Label Text="{Loc 'payment-console-col-name'}" StyleClasses="LabelSecondaryColor"
                       HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
                <Label Text="{Loc 'payment-console-col-job'}" StyleClasses="LabelSecondaryColor"
                       HorizontalExpand="True" SizeFlagsStretchRatio="1.5"/>
                <Label Text="{Loc 'payment-console-col-status'}" StyleClasses="LabelSecondaryColor" MinWidth="90"/>
                <Label Text="{Loc 'payment-console-col-salary'}" StyleClasses="LabelSecondaryColor" MinWidth="90"/>
                <Control MinWidth="218"/>
            </BoxContainer>

            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="MembersContainer" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True"/>
            </ScrollContainer>

            <Label Name="EmptyLabel" Text="{Loc 'payment-console-no-members'}"
                   StyleClasses="LabelSecondaryColor" HorizontalAlignment="Center" Margin="0 6" Visible="False"/>
        </BoxContainer>
    </PanelContainer>

</BoxContainer>
