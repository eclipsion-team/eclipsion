<controls:FancyWindow
                 xmlns="https://spacestation14.io"
                 xmlns:lateJoin="clr-namespace:Content.Client._NF.Latejoin"
                 xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
                 xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                 Title="{Loc 'late-join-title'}"
                 SetSize="600 500">
    <BoxContainer Orientation="Horizontal">
        <BoxContainer Orientation="Vertical" Margin="4 4" HorizontalExpand="True" SizeFlagsStretchRatio="1">
            <lateJoin:VesselListControl Name="VesselSelection" VerticalExpand="True"/>
        </BoxContainer>
        <cc:VSeparator StyleClasses="LowDivider"/>
        <BoxContainer Orientation="Vertical" Margin="4 4" HorizontalExpand="True" SizeFlagsStretchRatio="1">
            <Button Name="CrewManifestButton" Text="{Loc 'late-join-manifest'}" HorizontalAlignment="Center" Visible="False"/>
            <BoxContainer Name="DeployRow" Orientation="Horizontal" Margin="0 4" Visible="False">
                <Label Text="{Loc 'late-join-deploy-label'}" Margin="0 0 6 0"/>
                <OptionButton Name="DeployOption" HorizontalExpand="True"/>
            </BoxContainer>
            <!-- A ship with a lot of roles used to run straight off the bottom of the window. -->
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="JobList" Orientation="Vertical" HorizontalExpand="True"/>
            </ScrollContainer>
        </BoxContainer>
        <!--<cc:VSeparator StyleClasses="LowDivider"/>
        <BoxContainer Orientation="Vertical" Margin="4 4" HorizontalExpand="True" SizeFlagsStretchRatio="2">
            <RichTextLabel Name="ShipDescription"/>
        </BoxContainer>-->
    </BoxContainer>
</controls:FancyWindow>
