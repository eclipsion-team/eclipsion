<controls:BoxContainer Visible="False"
              HorizontalExpand="True"
              xmlns:controls="https://spacestation14.io"
              xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
              xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:ksui="clr-namespace:Content.Client._KS14.UI">
                <ui:ShuttleNavControl Name="NavRadar"
                                 MouseFilter="Stop"
                                 VerticalAlignment="Stretch"
                                 VerticalExpand="True"
                                 HorizontalExpand="True"
                                 Margin="5 4 10 5"/>
                <!-- Nav controls -->
                <controls:BoxContainer Name="RightDisplayNav"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"
                      VerticalExpand="True"
                      MinWidth="256"
                      MaxWidth="256"
                      Margin="5 0 5 5"
                      Orientation="Vertical">
                    <!-- KS14: instrument panel in place of the stock StripeBack header. -->
                    <ksui:KsInstrumentPanel Name="DisplayPanel" Margin="0 0 0 4">
                    <controls:GridContainer Columns="2"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   HorizontalExpand="True"
                                   Margin="3"
                                   Name="ReadonlyDisplay">
						<!-- Rat-start-->
						<controls:Label Text="{controls:Loc 'shuttle-console-shield'}"/>
						<controls:Label Name="ShieldStatus"
           						        Text=""
            						    HorizontalExpand="True"
             						    Align="Right"/>
						<!-- Rat-end-->
                        <controls:Label Text="Ship IFF:"/>
                        <controls:Label Name="ShipName"
                                        Text="No IFF"
                                        HorizontalExpand="True"
                                        Align="Right"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-position'}"/>
                        <controls:Label Name="GridPosition"
                               Text="0.0, 0.0"
                               HorizontalExpand="True"
                               Align="Right"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-orientation'}"/>
                        <controls:Label Name="GridOrientation"
                               Text="0.0"
                               HorizontalExpand="True"
                               Align="Right"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-linear-velocity'}"/>
                        <controls:Label Name="GridLinearVelocity"
                               Text="0.0, 0.0"
                               HorizontalExpand="True"
                               Align="Right"/>
                        <controls:Label Text="{controls:Loc 'shuttle-console-angular-velocity'}"/>
                        <controls:Label Name="GridAngularVelocity"
                               Text="0.0"
                               HorizontalExpand="True"
                               Align="Right"/>
                    </controls:GridContainer>
                    </ksui:KsInstrumentPanel>
                    <!-- KS14: instrument panel in place of the stock StripeBack header. -->
                    <ksui:KsInstrumentPanel Name="SettingsPanel">
                    <controls:BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <controls:Button Name="IFFToggle"
                            Text="{controls:Loc 'shuttle-console-iff-toggle'}"
                            TextAlign="Center"
                            ToggleMode="True"/>
                    <controls:Button Name="DockToggle"
                            Text="{controls:Loc 'shuttle-console-dock-toggle'}"
                            TextAlign="Center"
                            ToggleMode="True"/>
                    <controls:BoxContainer Orientation="Vertical" HorizontalExpand="True" Name="IffSearchBox">
                        <controls:Label Text="{controls:Loc 'shuttle-console-iff-search'}"/>
                        <controls:LineEdit Name="IffSearchCriteria" Access="Public" HorizontalExpand="True"/>
                    </controls:BoxContainer>
                    <controls:BoxContainer Orientation="Vertical" HorizontalExpand="True" Name="TargetCoordsBox">
                        <controls:Label Text="{controls:Loc 'shuttle-console-target'}"/>
                        <controls:BoxContainer Orientation="Horizontal"
                                               HorizontalExpand="True"
                                               Align="Center"
                                               Margin="0 0 0 3">
                            <controls:LineEdit Name="TargetX" Access="Public" HorizontalExpand="True"/>
                            <controls:LineEdit Name="TargetY" Access="Public" HorizontalExpand="True"/>
                            <controls:Button Name="TargetSet"
                                             Text="{controls:Loc 'shuttle-console-set-target'}"
                                             TextAlign="Center"
                                             MinWidth="20"
                                             ToolTip="{controls:Loc 'shuttle-console-set-target-description'}"
                                             StyleClasses="OpenRight"
                                             Margin="0"/>
                            <controls:Button Name="TargetShow"
                                             Text="{controls:Loc 'shuttle-console-hide-target'}"
                                             TextAlign="Center"
                                             ToggleMode="True"
                                             MinWidth="20"
                                             ToolTip="{controls:Loc 'shuttle-console-hide-target-description'}"
                                             StyleClasses="OpenLeft"
                                             Margin="0"/>
                        </controls:BoxContainer>
                    </controls:BoxContainer>
                    <!-- Frontier - Inertia dampener controls-->
                    <controls:BoxContainer Name="DampenerModeButtons"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Stretch"
                                  Margin="5">
                        <controls:Button Name="DampenerOff"
                                         Text="{controls:Loc 'nav-screen-free'}"
                                         TextAlign="Center"
                                         ToggleMode="True"
                                         MinWidth="82"
                                         MaxWidth="82"/>
                        <controls:Button Name="DampenerOn"
                                         Text="{controls:Loc 'nav-screen-dampen'}"
                                         TextAlign="Center"
                                         ToggleMode="True"
                                         MinWidth="82"
                                         MaxWidth="82"/>
                        <controls:Button Name="AnchorOn"
                                         Text="{controls:Loc 'nav-screen-anchor'}"
                                         TextAlign="Center"
                                         ToggleMode="True"
                                         MinWidth="82"
                                         MaxWidth="82"/>
                    </controls:BoxContainer>
                    <!--end Inertia dampener controls-->
                    <!-- hullrot modules -->
                    <controls:OptionButton Name="WeaponTargetingMode" Margin="5 2"/>
                    <controls:BoxContainer Name ="ButtonHolder" VerticalExpand="True" HorizontalExpand="False" Orientation="Vertical">
                        <controls:Button Name="Group1"
                                         Text="{controls:Loc 'Module A'}"
                                         TextAlign="Center"
                                         ToggleMode="False"/>
                        <controls:Button Name="Group2"
                                         Text="{controls:Loc 'Module B'}"
                                         TextAlign="Center"
                                         ToggleMode="False"/>
                        <controls:Button Name="Group3"
                                         Text="{controls:Loc 'Module C'}"
                                         TextAlign="Center"
                                         ToggleMode="False"/>
                        <controls:Button Name="Group4"
                                         Text="{controls:Loc 'Module D'}"
                                         TextAlign="Center"
                                         ToggleMode="False"/>
                        <controls:Button Name="Group5"
                                         Text="{controls:Loc 'Module E'}"
                                         TextAlign="Center"
                                         ToggleMode="False"/>
                    </controls:BoxContainer>

                    <controls:Button Name="RenameButton"
                                     Text="{controls:Loc 'Renaming mode'}"
                                     TextAlign="Center"
                                     ToggleMode="True"/>
                    </controls:BoxContainer>
                    </ksui:KsInstrumentPanel>
                    </controls:BoxContainer>
                </controls:BoxContainer>
