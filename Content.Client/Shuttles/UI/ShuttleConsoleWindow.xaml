<!--
  KS14: instrument-styled shell, ported from Klovnstation14 (AGPL-3.0-or-later).
  Visuals only: the stock FancyWindow chrome is replaced by a flat bezel, a VT323 title bar
  and a NAV // MAP // DOCK // CREW tab strip, but every screen below and all of their
  behaviour is this fork's own and unchanged.
-->
<ksui:KsBaseWindow xmlns="https://spacestation14.io"
                   xmlns:ksui="clr-namespace:Content.Client._KS14.UI"
                   xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                   xmlns:shuttle="clr-namespace:Content.Client._Crescent.Shuttle"
                   xmlns:politics="clr-namespace:Content.Client._Crescent.PoliticalMap"
                   MouseFilter="Stop"
                   SetSize="960 762"
                   MinSize="960 762">
    <!-- The instrument bezel: the whole window IS the instrument, no stock chrome. -->
    <PanelContainer Name="Bezel"/>
    <BoxContainer Orientation="Vertical" Margin="2">
        <!-- Custom title bar: VT323 title + close button. -->
        <PanelContainer Name="TitleBar">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 2 4 2">
                <Label Name="TitleLabel"
                       StyleClasses="KsInstrumentTitle"
                       HorizontalExpand="True"
                       VAlign="Center"
                       Text="{Loc 'shuttle-console-window-title'}"/>
                <Button Name="CloseChromeButton"
                        StyleClasses="KsInstrumentAction"
                        VerticalAlignment="Center"
                        Text="{Loc 'ks-instrument-window-close'}"/>
            </BoxContainer>
        </PanelContainer>
        <!-- Instrument tab strip: NAV // MAP // DOCK // CREW -->
        <BoxContainer Name="ModeButtons"
                      Orientation="Horizontal"
                      HorizontalAlignment="Stretch"
                      Margin="8 6 8 4">
            <Button Name="NavModeButton"
                    StyleClasses="KsInstrumentTab"
                    ToggleMode="True"
                    Text="{Loc 'ks-instrument-tab-nav'}"/>
            <Label Name="Sep1" StyleClasses="KsInstrumentStrong" Text="{Loc 'ks-instrument-tab-separator'}" Margin="6 0 6 0"/>
            <Button Name="MapModeButton"
                    StyleClasses="KsInstrumentTab"
                    ToggleMode="True"
                    Text="{Loc 'ks-instrument-tab-map'}"/>
            <Label Name="Sep2" StyleClasses="KsInstrumentStrong" Text="{Loc 'ks-instrument-tab-separator'}" Margin="6 0 6 0"/>
            <Button Name="DockModeButton"
                    StyleClasses="KsInstrumentTab"
                    ToggleMode="True"
                    Text="{Loc 'ks-instrument-tab-dock'}"/>
            <Label Name="Sep3" StyleClasses="KsInstrumentStrong" Text="{Loc 'ks-instrument-tab-separator'}" Margin="6 0 6 0"/>
            <Button Name="CrewManagementButton"
                    StyleClasses="KsInstrumentTab"
                    ToggleMode="True"
                    Text="{Loc 'ks-instrument-tab-crew'}"/>
            <!-- Crescent: the sector's political map. -->
            <Label Name="Sep4" StyleClasses="KsInstrumentStrong" Text="{Loc 'ks-instrument-tab-separator'}" Margin="6 0 6 0"/>
            <Button Name="PoliticsModeButton"
                    StyleClasses="KsInstrumentTab"
                    ToggleMode="True"
                    Text="{Loc 'ks-instrument-tab-politics'}"/>
        </BoxContainer>
        <!-- Contents box -->
        <BoxContainer Name="Contents"
                      HorizontalAlignment="Stretch"
                      VerticalExpand="True"
                      Margin="5">
            <ui:NavScreen Name="NavContainer" Visible="False"/>
            <ui:MapScreen Name="MapContainer" Visible="False"/>
            <ui:DockingScreen Name="DockContainer" Visible="False"/>
            <shuttle:CrewScreen Name="CrewContainer" Visible="False"/>
            <politics:PoliticalMapPanel Name="PoliticsContainer" Visible="False"/>
        </BoxContainer>
        <!-- KS14 shell: the always-on status strip. Deliberately fine print - it sits under
             every tab so the crew never has to go looking for it, without competing with
             the plot for attention. -->
        <PanelContainer Name="StatusStrip" Margin="8 2 8 6">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6 2 6 2">
                <Label Name="StatusLabel" StyleClasses="KsInstrumentSmall" HorizontalExpand="True"/>
                <Label Name="AlertLabel" StyleClasses="KsInstrumentSmall" Visible="False"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</ksui:KsBaseWindow>
