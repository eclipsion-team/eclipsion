<PanelContainer
        xmlns="https://spacestation14.io"
        StyleClasses="BackgroundDark"
        HorizontalExpand="True"
        Margin="0 0 0 4">
    <BoxContainer Orientation="Vertical" Margin="4">
        <BoxContainer Orientation="Horizontal">
            <CheckBox Name="Department" HorizontalExpand="True"/> <!-- Toggles every shown job in the department at once -->
            <Label Name="Count" StyleClasses="LabelSubText"/>
        </BoxContainer>
        <GridContainer Name="JobsContainer" Columns="3" Margin="16 0 0 0"/> <!-- Populated with each job to toggle individually -->
    </BoxContainer>
</PanelContainer>
